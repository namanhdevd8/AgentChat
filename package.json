{
  "name": "agent-chat",
  "productName": "Agent Chat",
  "version": "0.7.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node check.js",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "dev.namanh.agentchat",
    "copyright": "© 2026 Dam Huy Nam Anh",
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "index.html",
      "renderer.js",
      "build/icon.svg",
      "CHANGELOG.md"
    ],
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "markdown-it": "15.0.2"
  },
  "description": "Nhóm agent AI (Claude, Codex, agy) làm việc chung trong một box chat theo dự án",
  "author": "Dam Huy Nam Anh"
}
